# TEST D: hardcode wZ = 1.694 GeV (= Whizard's computed hadronic total) so
# that preset == computed and any residual-width re-routing has no effect.
# Hypothesis: if the bias disappears here, H1 is confirmed — the problem
# was the 0.784 GeV gap between computed and preset widths.
#
# Physics warning: wZ = 1.694 is NOT the SM value. Use ONLY for this
# diagnostic run.

model = SM

me     = 0.5109989e-3 GeV
mmu    = 0.10565837 GeV
ms     = 0
mc     = 1.27 GeV
mb     = 4.18 GeV
mtop   = 174 GeV
wtop   = 1.37 GeV
mW     = 80.45 GeV
wW     = 2.071 GeV
mZ     = 91.188 GeV
wZ     = 1.694 GeV       # DIAGNOSTIC HACK: match Whizard's computed total width
mH     = 125 GeV
wH     = 0.00407 GeV

alias q_light = u:d:s
alias Q_light = U:D:S

sqrts = 10 TeV
seed  = 1234

process vbfz   = "e2", "E2" => "n2", "N2", "Z"
process z_uds  = "Z" => q_light, Q_light
process z_cc   = "Z" => c, C
process z_bb   = "Z" => b, B

compile

cuts = all M  > 150 GeV [n2, N2] and
       all Pt > 5   GeV [n2, N2] and
       all Pt > 500 GeV [Z] and
       all abs (Eta) < 2.3 [Z]

?ps_fsr_active       = true
?hadronization_active = true
?allow_shower        = true
$shower_method       = "PYTHIA8"
$hadronization_method = "PYTHIA8"

integrate (z_uds)
integrate (z_cc)
integrate (z_bb)
unstable "Z" (z_uds, z_cc, z_bb)
integrate (vbfz) { iterations = 5:50000:"gw", 10:100000 }

simulate (vbfz) {
  n_events = 100
  sample_max_tries = 100000
  $sample = "mumu_vbfZ_testD_wZhack_10TeV"
  sample_format = hepmc
}
