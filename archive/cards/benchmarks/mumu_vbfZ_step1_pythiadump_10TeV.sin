# STEP 1: dump Pythia8 internal state after applying the Set 3 config,
# so we can see how Pythia interprets '23:onIfAny = 1 2 3 4 5'.

model = SM

me     = 0.5109989e-3 GeV
mmu    = 0.10565837 GeV
ms     = 0
mc     = 1.27 GeV
mb     = 4.18 GeV
mtop   = 174 GeV
wtop   = 1.37 GeV
mW     = 80.45 GeV
wW     = 2.071 GeV
mZ     = 91.188 GeV
wZ     = 2.478 GeV
mH     = 125 GeV
wH     = 0.00407 GeV

sqrts = 10 TeV
seed  = 1234

process vbfz = "e2", "E2" => "n2", "N2", "Z"

compile

cuts = all M  > 150 GeV [n2, N2] and
       all Pt > 5   GeV [n2, N2] and
       all Pt > 500 GeV [Z]

?ps_fsr_active       = true
?hadronization_active = true
?allow_shower        = true
$shower_method       = "PYTHIA8"
$hadronization_method = "PYTHIA8"

# Diagnostic: dump Pythia's settings + Z particle data after applying config.
# Semicolon-separated Pythia readString() commands; all on one logical line.
$ps_PYTHIA8_config = "Init:showChangedSettings = on; Init:showOneParticleData = 23; Next:numberShowEvent = 2; Next:numberShowInfo = 2; Next:numberShowProcess = 2; 23:mayDecay = on; 23:onMode = off; 23:onIfAny = 1 2 3 4 5"

integrate (vbfz) { iterations = 5:50000:"gw", 10:100000 }

simulate (vbfz) {
  n_events = 5
  sample_max_tries = 100000
  $sample = "mumu_vbfZ_step1_10TeV"
  sample_format = hepmc
}
