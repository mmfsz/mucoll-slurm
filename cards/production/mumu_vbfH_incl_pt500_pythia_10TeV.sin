# mumu_vbfH_10TeV  (Set 1: stable H, Pythia8 default decays)
########################################################################
# mu+ mu- -> nu_mu nu_mu_bar H  at 10 TeV  (WW fusion, single boosted H)
#
# H is left stable in Whizard. Pythia8 (invoked during showering) will
# decay it with its default branching ratios.
#
# Author: Maria Mazza
########################################################################

model = SM

# Masses and widths
me     = 0.5109989e-3 GeV
mmu    = 0.10565837 GeV
ms     = 0
mc     = 1.27 GeV
mb     = 4.18 GeV
mtop   = 174 GeV
wtop   = 1.37 GeV
mW     = 80.45 GeV
wW     = 2.071 GeV
mZ     = 91.188 GeV
wZ     = 2.478 GeV
mH     = 125 GeV
wH     = 0.00407 GeV

# CoM energy and seed
sqrts = 10 TeV
seed  = 1234

# WW-fusion single-H: mu- mu+ -> nu_mu nu_mu_bar H
process vbfh = "e2", "E2" => "n2", "N2", "H"

compile

# VBF kinematics on the tag pair + boosted-H cut
cuts = all M  > 150 GeV [n2, N2] and
       all Pt > 5   GeV [n2:N2] and
       all Pt > 500 GeV [H] and
       all abs (Eta) < 2.3 [H]

# Parton shower + hadronization via Pythia8
?ps_fsr_active       = true
?hadronization_active = true
?allow_shower        = true
$shower_method       = "PYTHIA8"
$hadronization_method = "PYTHIA8"

integrate (vbfh) { iterations = 5:50000:"gw", 10:100000 }
show(results)

simulate (vbfh) {
  n_events = 1000
  sample_max_tries = 100000
  $sample = "mumu_vbfH_10TeV"
  sample_format = hepmc
}
