# mumu_ZHbbbb_inclusive_10TeV
########################################################################
# mu+mu- -> b bbar b bbar at 10 TeV (inclusive ME level)
# All 2->4 diagrams included (ZH, ZZ, HH, etc.); no unstable decays.
# Pythia8 handles showering and hadronization only.
#
# Author: Maria Mazza
########################################################################

model = SM

# Masses and widths
me     = 0d0
mmu    = 0d0
mb     = 4.18 GeV
mtop   = 174 GeV
wtop   = 1.37 GeV
mW     = 80.45 GeV
wW     = 2.071 GeV
mZ     = 91.188 GeV
wZ     = 2.478 GeV
mH     = 125 GeV
wH     = 0.00407 GeV

# CoM energy and seed
sqrts = 10 TeV
seed = 1234 # randomize for production runs

# Inclusive 2->4 production: mu+mu- -> b bbar b bbar
# Includes all contributing diagrams (s-channel ZH, ZZ, HH, continuum)
process bbbb = "e2", "E2" => b, B, b, B

# Compile matrix elements
compile

# Acceptance cut on the final-state b quarks (harmonized with the other inclusive cards)
cuts = all abs (Eta) < 2.3 [b, B]

# Parton shower and hadronization via Pythia8
?ps_fsr_active = true
?hadronization_active = true
?allow_shower = true
$shower_method = "PYTHIA8"
$hadronization_method = "PYTHIA8"

# Integrate production
integrate (bbbb) { iterations = 5:50000:"gw", 10:100000 }
show(results)

# Generate events
simulate (bbbb) {
  n_events = 1000
  sample_max_tries = 100000
  $sample = "mumu_ZHbbbb_inclusive_10TeV"
  sample_format = hepmc
}
