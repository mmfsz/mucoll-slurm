# mumu_ZHbbbb_lhe_10TeV  (LHE route: parton-level LHE from Whizard, shower in Pythia8)
########################################################################
# mu+mu- -> ZH (s-channel) at 10 TeV
#
# Whizard produces a parton-level LHE file (matrix element only).
# Z and H are kept stable — no unstable keyword.
# Pythia8 reads the LHE and performs decays, showering, hadronization,
# giving each boson independent color flow with no cross-boson string
# connections.
#
# Author: Maria Mazza
########################################################################

model = SM

# Masses and widths
me     = 0d0
mmu    = 0d0
mtop   = 174 GeV
wtop   = 1.37 GeV
mW     = 80.45 GeV
wW     = 2.071 GeV
mZ     = 91.188 GeV
wZ     = 2.478 GeV
mH     = 125 GeV
wH     = 0.00407 GeV

sqrts = 10 TeV
seed  = 1234

# s-channel production: mu+mu- -> ZH; Z and H left stable for Pythia8
process zhprod = "e2", "E2" => "Z", "H"

compile

cuts = all abs (Eta) < 2.3 [Z, H]

# No shower/hadronization in Whizard — Pythia8 will handle everything
?ps_fsr_active        = false
?hadronization_active = false
?allow_shower         = false

integrate (zhprod) { iterations = 5:50000:"gw", 10:100000 }
show(results)

simulate (zhprod) {
  n_events = 10
  sample_max_tries = 100000
  $sample = "mumu_ZHbbbb_lhe_10TeV"
  sample_format = lhef
}
