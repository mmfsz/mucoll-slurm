# mumu_vbfWqq_inclusive_10TeV  —  2->4 VBF hadronic W, inclusive (no W resonance)
########################################################################
# mu+ mu- -> (mu- nu_mu_bar q qbar') + c.c. at 10 TeV (WZ fusion + all
# interfering diagrams). No explicit W in the ME, no unstable, no Pythia
# resonance decay. Colour flow is handed directly from Whizard's omega ME
# to Pythia for shower + hadronization. Workaround for the multi-channel
# `unstable` sampling bias.
#
# Both W charges are generated:
#   W+: mu- nu_mu_bar (u dbar/sbar) or (c dbar/sbar)
#   W-: mu+ nu_mu    (ubar d/s)    or (cbar d/s)
#
# The qq' system is on-shell-W-like thanks to the 70 < M(jj) < 90 GeV
# cut. Boosted regime from pT(q, qbar') > 250 GeV each.
#
# Author: Maria Mazza
########################################################################

model = SM

me     = 0.5109989e-3 GeV
mmu    = 0.10565837 GeV
ms     = 0
mc     = 1.27 GeV
mb     = 4.18 GeV
mtop   = 174 GeV
wtop   = 1.37 GeV
mW     = 80.45 GeV
wW     = 2.071 GeV
mZ     = 91.188 GeV
wZ     = 2.478 GeV
mH     = 125 GeV
wH     = 0.00407 GeV

# Massless down-type quarks (d, s) and their antiparticles
alias q_down = d:s
alias Q_down = D:S

# Tag-system aliases (lepton + neutrino)
alias lTag  = e2:E2
alias nuTag = n2:N2

# Aliases used in cuts over the hadronic final state
alias any_jq = u:c:d:s
alias any_jQ = U:C:D:S

sqrts = 10 TeV
seed  = 1234

# Inclusive 2->4, split by quark mass (massless u separate from massive c):
#   W+ hadronic: mu- nu_mu_bar + u (Q_down) or c (Q_down)
#   W- hadronic: mu+ nu_mu   + U (q_down) or C (q_down)
process vbfwqq = "e2", "E2" =>
      ("e2", "N2", u, Q_down)
    + ("e2", "N2", c, Q_down)
    + ("E2", "n2", U, q_down)
    + ("E2", "n2", C, q_down)

compile

# Cuts:
#   - VBF tag:       M(l, nu) > 150 GeV, pT(each) > 5 GeV
#   - On-shell W:    70 < M(jj) < 90 GeV  (± ~10 GeV around mW)
#   - Boosted jets:  pT(each q) > 250 GeV
#   - Acceptance:    |eta(each q)| < 2.3
cuts = all M  > 150 GeV [lTag, nuTag] and
       all Pt > 5   GeV [lTag, nuTag] and
       all M  > 70  GeV [any_jq, any_jQ] and
       all M  < 90  GeV [any_jq, any_jQ] and
       all Pt > 250 GeV [any_jq, any_jQ] and
       all abs (Eta) < 2.3 [any_jq, any_jQ]

?ps_fsr_active       = true
?hadronization_active = true
?allow_shower        = true
$shower_method       = "PYTHIA8"
$hadronization_method = "PYTHIA8"

integrate (vbfwqq) { iterations = 5:50000:"gw", 10:100000 }
show(results)

simulate (vbfwqq) {
  n_events = 100
  sample_max_tries = 100000
  $sample = "mumu_vbfWqq_inclusive_10TeV"
  sample_format = hepmc
}
