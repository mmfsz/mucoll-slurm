# mumu_vbfH_10TeV  —  Gridpack (phase-space integration only)
########################################################################
# WW-fusion single-H at 10 TeV, pT(H) > 500 GeV.
# Shared by Sets 1/2/3 production cards — they all use the same hard ME.
# Run once with many CPUs; production jobs load the resulting .vg files.
########################################################################

model = SM

me     = 0.5109989e-3 GeV
mmu    = 0.10565837 GeV
ms     = 0
mc     = 1.27 GeV
mb     = 4.18 GeV
mtop   = 174 GeV
wtop   = 1.37 GeV
mW     = 80.45 GeV
wW     = 2.071 GeV
mZ     = 91.188 GeV
wZ     = 2.478 GeV
mH     = 125 GeV
wH     = 0.00407 GeV

sqrts = 10 TeV
seed  = 1234

process vbfh = "e2", "E2" => "n2", "N2", "H"

compile

cuts = all M  > 150 GeV [n2, N2] and
       all Pt > 5   GeV [n2, N2] and
       all Pt > 500 GeV [H] and
       all abs (Eta) < 2.3 [H]

# Match the production card iteration parameters exactly so the grid is
# fully-optimised when production loads it.
integrate (vbfh) { iterations = 5:50000:"gw", 10:100000 }
