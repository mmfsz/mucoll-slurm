# mumu_vbfW_10TeV  —  Gridpack (phase-space integration only)
########################################################################
# WZ / W-gamma fusion single-W at 10 TeV, pT(W) > 500 GeV.
# Both charges summed. Shared by Sets 1/2/3 production cards.
########################################################################

model = SM

me     = 0.5109989e-3 GeV
mmu    = 0.10565837 GeV
ms     = 0
mc     = 1.27 GeV
mb     = 4.18 GeV
mtop   = 174 GeV
wtop   = 1.37 GeV
mW     = 80.45 GeV
wW     = 2.071 GeV
mZ     = 91.188 GeV
wZ     = 2.478 GeV
mH     = 125 GeV
wH     = 0.00407 GeV

alias lTag  = e2:E2
alias nuTag = n2:N2

sqrts = 10 TeV
seed  = 1234

process vbfw = "e2", "E2" => ("e2", "N2", "W+") + ("E2", "n2", "W-")

compile

cuts = all M  > 150 GeV [lTag, nuTag] and
       all Pt > 5   GeV [lTag, nuTag] and
       all Pt > 500 GeV ["W+", "W-"] and
       all abs (Eta) < 2.3 ["W+", "W-"]

integrate (vbfw) { iterations = 5:50000:"gw", 10:100000 }
