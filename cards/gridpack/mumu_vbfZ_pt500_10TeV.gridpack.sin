# mumu_vbfZ_10TeV  —  Gridpack (phase-space integration only)
########################################################################
# WW-fusion single-Z (via WWZ vertex) at 10 TeV, pT(Z) > 500 GeV.
# Shared by Sets 1/2/3 production cards.
########################################################################

model = SM

me     = 0.5109989e-3 GeV
mmu    = 0.10565837 GeV
ms     = 0
mc     = 1.27 GeV
mb     = 4.18 GeV
mtop   = 174 GeV
wtop   = 1.37 GeV
mW     = 80.45 GeV
wW     = 2.071 GeV
mZ     = 91.188 GeV
wZ     = 2.478 GeV
mH     = 125 GeV
wH     = 0.00407 GeV

sqrts = 10 TeV
seed  = 1234

process vbfz = "e2", "E2" => "n2", "N2", "Z"

compile

cuts = all M  > 150 GeV [n2, N2] and
       all Pt > 5   GeV [n2:N2] and
       all Pt > 500 GeV [Z] and
       all abs (Eta) < 2.3 [Z]

integrate (vbfz) { iterations = 5:50000:"gw", 10:100000 }
